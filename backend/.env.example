# Copy to backend/.env for running the API outside Docker. Every variable: chatdocs/platform/config.py
ENVIRONMENT=dev
APP_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
DATABASE_URL=postgresql+asyncpg://chatdocs:chatdocs@localhost:5432/chatdocs
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=chat-docs
S3_ACCESS_KEY=chatdocs
S3_SECRET_KEY=chatdocs-secret
OIDC_ISSUER=http://localhost:8080/realms/chatdocs
OIDC_CLIENT_ID=chatdocs
OIDC_CLIENT_SECRET=chatdocs-dev-secret
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
EMBEDDER_URL=http://localhost:8081
OIDC_INTERNAL_BASE_URL=
ANALYTICS_HMAC_KEY=change-me-analytics-key
# EN-06: fake (no key) | anthropic | openai_compatible
LLM_PROVIDER=fake
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=
LLM_BASE_URL=
# P1 / P2 flags: history, duplicate, stream_render, followup, evaluation; qa_off = kill switch (REL-03)
FEATURE_FLAGS=history,duplicate,stream_render
