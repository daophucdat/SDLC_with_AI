        <mxCell id="fr1s0g" value="[else]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;labelBackgroundColor=#F5F5F5;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="68" y="642" width="120" height="20" as="geometry"/></mxCell>
        <mxCell id="fr2g" value="[còn phần trả lời]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;labelBackgroundColor=#F5F5F5;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="432" y="807" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="fr3g" value="[quá 30 giây hoặc dịch vụ AI lỗi]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;labelBackgroundColor=#F5F5F5;fontSize=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="260" y="967" width="300" height="20" as="geometry"/></mxCell>
