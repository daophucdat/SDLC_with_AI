{
  "name": "chatdocs-e2e",
  "private": true,
  "version": "0.1.0",
  "description": "EN-12: end-to-end (Playwright), accessibility (axe) and load (k6) tests for Chat với tài liệu",
  "scripts": {
    "fixtures": "node -e \"require('child_process').execFileSync(process.env.E2E_PYTHON || require('path').join('..','backend','.venv',process.platform==='win32'?'Scripts/python.exe':'bin/python'),['fixtures/build_fixtures.py'],{stdio:'inherit'})\"",
    "test:tc": "npm run fixtures && playwright test",
    "test": "playwright test",
    "test:a11y": "playwright test specs/a11y.spec.ts",
    "report": "playwright show-report",
    "perf": "k6 run perf/ask.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.8.5",
    "@playwright/test": "1.40.1",
    "@types/node": "^18.19.50",
    "typescript": "5.5.4"
  }
}
